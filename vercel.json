{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py?path=$1"
    },
    {
      "src": "/docs",
      "dest": "api/index.py?path=docs"
    },
    {
      "src": "/openapi.json",
      "dest": "api/index.py?path=openapi.json"
    },
    {
      "src": "/assets/(.*)",
      "dest": "assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}
