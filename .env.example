# AgriLink Environment Variables Template
# Copy to .env and configure your keys

# Optional: Google AI Studio / Gemini API Key for dynamic LLM reasoning
# If omitted or empty, the platform automatically utilizes the deterministic Agronomic Rules Engine fallback
GEMINI_API_KEY=

# Vertex AI Gemini conversational advisor
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_GEMINI_MODEL=gemini-3.5-flash-lite

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database Configuration (Defaults to local SQLite agrilink.db)
DATABASE_URL=sqlite:///./agrilink.db
